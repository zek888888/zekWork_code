{% block extra_js %}
<script src="https://cdn.jsdelivr.net/npm/echarts@5.4.3/dist/echarts.min.js"></script>
<script>
// 全局变量
let btcChart = null;
let currentInterval = '15m';
let autoRefreshIntervals = {};

// 初始化
$(document).ready(function() {
    initBTCChart();
    loadAllData();
    startAutoRefresh();
    
    // 时间周期切换
    $('.time-btn').click(function() {
        $('.time-btn').removeClass('active');
        $(this).addClass('active');
        currentInterval = $(this).data('interval');
        refreshBTCData();
    });
});

// 初始化BTC图表
function initBTCChart() {
    btcChart = echarts.init(document.getElementById('btcChart'));
    refreshBTCData();
}

// 刷新BTC数据
function refreshBTCData() {
    $.getJSON(`/api/crypto/btc?interval=${currentInterval}`, function(data) {
        updateBTCPrice(data.price, data.change);
        updateBTCChart(data.klines);
    });
}

// 更新BTC价格显示
function updateBTCPrice(price, change) {
    $('#btcPrice').text(`$${price.toLocaleString()}`);
    const changeClass = change >= 0 ? 'badge-success' : 'badge-danger';
    const changeIcon = change >= 0 ? 'ti-trending-up' : 'ti-trending-down';
    $('#btcChange').attr('class', `badge btc-change-badge ${changeClass}`)
                   .html(`<i class="ti ${changeIcon}"></i> ${change >= 0 ? '+' : ''}${change.toFixed(2)}%`);
}

// 更新BTC图表
function updateBTCChart(klines) {
    const option = {
        backgroundColor: 'transparent',
        animation: false,
        grid: [
            { left: '2%', right: '2%', top: '3%', height: '52%' },
            { left: '2%', right: '2%', top: '58%', height: '18%' },
            { left: '2%', right: '2%', top: '78%', height: '18%' }
        ],
        xAxis: [
            { type: 'category', gridIndex: 0, data: klines.times, axisLine: { lineStyle: { color: '#2d3142' } }, axisLabel: { color: '#64748b', fontSize: 9 } },
            { type: 'category', gridIndex: 1, data: klines.times, axisLine: { show: false }, axisLabel: { show: false } },
            { type: 'category', gridIndex: 2, data: klines.times, axisLine: { lineStyle: { color: '#2d3142' } }, axisLabel: { color: '#64748b', fontSize: 9 } }
        ],
        yAxis: [
            { type: 'value', gridIndex: 0, axisLine: { show: false }, splitLine: { lineStyle: { color: '#2d3142' } }, axisLabel: { color: '#64748b', fontSize: 9 } },
            { type: 'value', gridIndex: 1, axisLine: { show: false }, splitLine: { show: false }, axisLabel: { show: false } },
            { type: 'value', gridIndex: 2, axisLine: { show: false }, splitLine: { show: false }, axisLabel: { color: '#64748b', fontSize: 9 } }
        ],
        series: [
            // K线
            {
                type: 'candlestick',
                xAxisIndex: 0,
                yAxisIndex: 0,
                data: klines.candles,
                itemStyle: {
                    color: '#00d084',
                    color0: '#ef4444',
                    borderColor: '#00d084',
                    borderColor0: '#ef4444'
                }
            },
            // 成交量
            {
                type: 'bar',
                xAxisIndex: 1,
                yAxisIndex: 1,
                data: klines.volumes,
                itemStyle: { color: (params) => klines.candles[params.dataIndex][1] > klines.candles[params.dataIndex][0] ? '#00d084' : '#ef4444' }
            },
            // MACD
            {
                type: 'line',
                xAxisIndex: 2,
                yAxisIndex: 2,
                data: klines.macd,
                lineStyle: { color: '#3b82f6', width: 1 },
                symbol: 'none'
            },
            {
                type: 'bar',
                xAxisIndex: 2,
                yAxisIndex: 2,
                data: klines.macdHist,
                itemStyle: { color: (params) => params.value >= 0 ? '#00d084' : '#ef4444' }
            }
        ]
    };
    btcChart.setOption(option);
}

// 加载新闻
function loadNews() {
    $.getJSON('/api/news/latest', function(data) {
        let html = '';
        data.slice(0, 5).forEach(news => {  // 限制显示5条
            const sentimentClass = news.sentiment_score > 0.2 ? 'positive' : news.sentiment_score < -0.2 ? 'negative' : 'neutral';
            const sentimentIcon = news.sentiment_score > 0.2 ? 'ti-mood-happy' : news.sentiment_score < -0.2 ? 'ti-mood-sad' : 'ti-mood-empty';
            
            html += `
                <div class="news-card ${sentimentClass} rounded">
                    <div class="news-title">${news.title}</div>
                    <div class="news-meta">
                        <span class="news-source">
                            <i class="ti ti-source-code"></i> ${news.source}
                        </span>
                        <span class="news-sentiment">
                            <i class="ti ${sentimentIcon}"></i> ${(news.sentiment_score * 100).toFixed(1)}%
                        </span>
                        <span>${news.published_at}</span>
                    </div>
                    <div class="news-keywords">
                        ${news.keywords ? news.keywords.split(',').slice(0, 3).map(k => `<span class="badge badge-secondary">${k.trim()}</span>`).join('') : ''}
                    </div>
                </div>
            `;
        });
        $('#newsContainer').html(html);
    });
}

// 加载热点土狗
function loadMemeCoins() {
    $.getJSON('/api/gmgn/hot', function(data) {
        let html = '';
        data.slice(0, 6).forEach((token, index) => {  // 限制显示6条
            const rankClass = index < 3 ? 'top3' : '';
            const changeClass = token.change_24h >= 0 ? 'text-success' : 'text-danger';
            html += `
                <div class="token-card">
                    <div class="token-rank ${rankClass}">${index + 1}</div>
                    <div class="token-icon">${token.symbol[0]}</div>
                    <div class="token-info">
                        <div class="token-name">${token.name}</div>
                        <div class="token-symbol">${token.symbol}</div>
                    </div>
                    <div class="token-price">
                        <div class="token-price-value">$${token.price.toFixed(6)}</div>
                        <div class="token-price-change ${changeClass}">${token.change_24h >= 0 ? '+' : ''}${token.change_24h.toFixed(2)}%</div>
                    </div>
                </div>
            `;
        });
        $('#memeContainer').html(html);
    });
}

// 加载板块追踪
function loadSectors() {
    const sectors = [
        { name: '科技板块', change: 2.35, leaders: [
            { name: '腾讯控股', code: '00700', change: 1.85 },
            { name: '阿里巴巴', code: '09988', change: 2.45 },
            { name: '美团', code: '03690', change: 3.12 }
        ]},
        { name: '金融板块', change: -0.52, leaders: [
            { name: '中国平安', code: '02318', change: -0.35 },
            { name: '招商银行', code: '03968', change: -0.68 },
            { name: '工商银行', code: '01398', change: -0.42 }
        ]},
        { name: '新能源', change: 3.78, leaders: [
            { name: '比亚迪', code: '01211', change: 4.25 },
            { name: '宁德时代', code: '300750', change: 3.56 },
            { name: '隆基绿能', code: '601012', change: 3.89 }
        ]}
    ];
    
    let html = '<div class="row g-2">';
    sectors.forEach(sector => {
        const changeClass = sector.change >= 0 ? 'text-success' : 'text-danger';
        html += `
            <div class="col-md-4">
                <div class="card sector-card">
                    <div class="card-body" style="padding: 8px;">
                        <div class="sector-header">
                            <span class="sector-name">${sector.name}</span>
                            <span class="sector-change ${changeClass}">${sector.change >= 0 ? '+' : ''}${sector.change}%</span>
                        </div>
                        <div class="sector-leaders">
                            ${sector.leaders.map((leader, i) => `
                                <div class="leader-item">
                                    <div class="leader-info">
                                        <span class="leader-rank">${i + 1}</span>
                                        <span class="leader-name">${leader.name}</span>
                                        <span class="leader-code">${leader.code}</span>
                                    </div>
                                    <span class="leader-change ${leader.change >= 0 ? 'text-success' : 'text-danger'}">${leader.change >= 0 ? '+' : ''}${leader.change}%</span>
                                </div>
                            `).join('')}
                        </div>
                    </div>
                </div>
            </div>
        `;
    });
    html += '</div>';
    $('#sectorContainer').html(html);
}

// 加载聪明钱包
function loadWallets() {
    $.getJSON('/api/smart_wallet/list', function(data) {
        if (data.length === 0) {
            $('#walletContainer').html(`
                <div class="text-center py-3 text-muted">
                    <p class="mb-0" style="font-size: 11px;">暂无追踪的钱包</p>
                    <small style="font-size: 9px;">添加钱包地址开始追踪</small>
                </div>
            `);
            return;
        }
        
        let html = '<div class="wallet-list">';
        data.forEach(wallet => {
            html += `
                <div class="wallet-item">
                    <div class="wallet-header">
                        <span class="wallet-address">${wallet.address.slice(0, 6)}...${wallet.address.slice(-4)}</span>
                        <span class="wallet-total">$${wallet.total_value.toLocaleString()}</span>
                    </div>
                    <div class="wallet-holdings">
                        ${wallet.holdings.slice(0, 3).map(h => `
                            <div class="holding-item">
                                <div class="holding-token">
                                    <span>${h.token}</span>
                                </div>
                                <div class="holding-amount">
                                    <div>${h.amount.toLocaleString()}</div>
                                    <small class="text-muted">$${h.value.toLocaleString()}</small>
                                </div>
                            </div>
                        `).join('')}
                    </div>
                </div>
            `;
        });
        html += '</div>';
        $('#walletContainer').html(html);
    });
}

// 添加钱包
function addWallet() {
    const address = $('#walletAddress').val().trim();
    if (!address || !address.startsWith('0x')) {
        alert('请输入有效的钱包地址');
        return;
    }
    
    $.post('/api/smart_wallet/add', { address: address }, function(data) {
        $('#walletAddress').val('');
        loadWallets();
    });
}

// 加载所有数据
function loadAllData() {
    loadNews();
    loadMemeCoins();
    loadSectors();
    loadWallets();
    updateLastUpdateTime();
}

// 刷新所有数据
function refreshAllData() {
    $('.refresh-btn').addClass('spinning');
    loadAllData();
    setTimeout(() => $('.refresh-btn').removeClass('spinning'), 1000);
}

// 刷新单个模块
function refreshNews() { loadNews(); }
function refreshMemeCoins() { loadMemeCoins(); }

// 更新最后更新时间
function updateLastUpdateTime() {
    const now = new Date();
    $('#lastUpdate').text(`最后更新: ${now.toLocaleTimeString()}`);
}

// 启动自动刷新
function startAutoRefresh() {
    // BTC数据每15秒刷新
    autoRefreshIntervals.btc = setInterval(refreshBTCData, 15000);
    
    // 新闻每5分钟刷新
    autoRefreshIntervals.news = setInterval(loadNews, 300000);
    
    // 土狗每30秒刷新
    autoRefreshIntervals.meme = setInterval(loadMemeCoins, 30000);
}

// 窗口大小改变时重绘图表
window.addEventListener('resize', () => {
    if (btcChart) btcChart.resize();
});
</script>
{% endblock %}
